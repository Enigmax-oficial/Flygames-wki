# ==============================================================================
# Cloudflare Worker Production Secrets
# ==============================================================================
# NOTE: DO NOT store real secret values in this file or commit them to source control.
# JWT_SECRET, RESEND_API_KEY, and RESEND_FROM_EMAIL must be exported in your local shell
# or configured as CI/CD pipeline environment variables before running deployment scripts.
# The automated deploy script (scripts/set-secrets.sh) non-interactively sets these
# in Cloudflare via `wrangler secret put` using process environment variables.
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ==============================================================================
# Application & AI Studio Runtime Variables
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL Database Credentials
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
VITE_GOOGLE_CLIENT_ID=

# Cloudflare D1 Credentials (Non-emulated Mode)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

