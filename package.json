  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=server.js",
    "start": "node server.ts",
    "clean": "rimraf dist server.js server.cjs",
    "lint": "tsc --noEmit",
    "test": "jest",
    "verify-lockfile": "bun install --frozen-lockfile"
  },
